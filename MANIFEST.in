include LICENSE NOTICE THIRD_PARTY_NOTICES.md README.zh-CN.md
recursive-include docs *.md
recursive-include configs *.json
recursive-include examples *.json *.md *.py
recursive-include assets *.svg *.png *.gif
recursive-include extensions *.md *.json *.patch *.py
