[
  {
    "name": "failure_analyzer",
    "title": "Failure evidence analysis",
    "title_zh": "失败证据分析",
    "runtime": "llm",
    "input_schema": {
      "type": "object",
      "properties": {
        "failure_case": {
          "type": "object"
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array"
        },
        "image_paths": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "config_path": {
          "type": "string"
        },
        "run_name": {
          "type": "string"
        },
        "resume": {
          "type": "boolean"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "description": "Analyze observations and uncertainty without inventing missing evidence."
  },
  {
