  },
  {
    "name": "edit_config_generator",
    "title": "Edit configuration compiler",
    "title_zh": "编辑配置编译",
    "runtime": "native + llm",
    "input_schema": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "trajectory_edit",
                  "rotate",
                  "scale",
                  "remove",
                  "add",
                  "replace"
                ]
              },
              "instance_id": {
                "type": "integer",
                "minimum": 0
              },
              "waypoints": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "minItems": 1
              },
              "method": {
                "type": "string",
                "enum": [
                  "linear",
                  "catmull_rom"
                ]
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "asset_path": {
                "type": "string",
                "minLength": 1
              },
              "anchor_pixel": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "edit_plan": {
          "type": "string",
          "minLength": 1
        },
        "instances": {
          "type": "array"
        },
        "coordinate_system": {
          "type": "string",
          "enum": [
            "camera_local_meters",
            "backend_world"
          ]
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "instance_info_path": {
          "type": "string"
        },
        "asset_path": {
          "type": "string"
        },
        "asset_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "output_kind": {
          "type": "string",
          "enum": [
            "rigid_config",
            "ego_trajectory_offsets"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "description": "Compile typed edits into a portable, validated scene-edit document."
  },
