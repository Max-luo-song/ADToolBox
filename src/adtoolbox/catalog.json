  {
    "name": "edit_plan_builder",
    "title": "Scene edit planning",
    "title_zh": "场景编辑计划",
    "runtime": "llm",
    "input_schema": {
      "type": "object",
      "properties": {
        "edit_request": {
          "type": "string",
          "minLength": 1
        },
        "scene_info": {
          "type": "object"
        },
        "instances": {
          "type": "array"
        }
      },
      "required": [
        "edit_request"
      ],
      "additionalProperties": false
    },
