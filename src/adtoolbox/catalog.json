  {
    "name": "video_retriever",
    "title": "Driving video retrieval",
    "title_zh": "驾驶视频检索",
    "runtime": "native + engine",
    "input_schema": {
      "type": "object",
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "catalog_path": {
          "type": "string",
          "minLength": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "export_path": {
          "type": "string",
          "minLength": 1
        },
        "min_score": {
          "type": "number",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "enum": [
            "search",
            "index",
            "search_internet"
          ]
        },
        "video_path": {
          "type": "string",
          "minLength": 1
        },
        "library": {
          "type": "string",
          "enum": [
            "default",
            "waymo"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "description": "Index video clips, perform multimodal semantic recall, rerank candidates and export selected clips."
  },
  {
    "name": "instance_discovery",
    "title": "Traffic instance tracking",
    "title_zh": "交通实例跟踪",
