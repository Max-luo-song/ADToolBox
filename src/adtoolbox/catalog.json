          "type": "string",
          "minLength": 1
        },
        "num_frames": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "pixel_space": {
          "type": "string",
